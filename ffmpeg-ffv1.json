{
    "name": "ffmpeg-ffv1",
    "description": "FFV1 lossless video decoder",
    "filters":["ffdec"],
    "help": "This is a reduced version of ffmpeg carrying the FFV1 decoder only. FFV1 is a lossless intra-frame video codec used for archiving; its reference implementation is ffmpeg itself.",
    "support": [
        "video"
    ],
    "sources":"https://bevara.ddns.net/sources/ffmpeg-ffv1.accessor",
    "filter_source":{
        "ffdec" : "ff_dec-ffv1.c"
    },
    "Format": ["FFV1"],
    "using": ["solver_1"],
    "runtime": {
        "ffdec": {
            "outputs": [
                {
                    "property": "GF_PROP_PID_PIXFMT",
                    "format": [
                        "GF_PIXEL_RGB",
                        "GF_PIXEL_YUV",
                        "GF_PIXEL_RGBA",
                        "GF_PIXEL_YUV_10",
                        "GF_PIXEL_YUV422",
                        "GF_PIXEL_YUV422_10",
                        "GF_PIXEL_YUV444",
                        "GF_PIXEL_YUV444_10"
                    ]
                }
            ]
        }
    },
    "patents": {
        "status": "royalty-free",
        "note": "FFV1 (RFC 9043)",
        "checked": "2026-10-16"
    }
}
